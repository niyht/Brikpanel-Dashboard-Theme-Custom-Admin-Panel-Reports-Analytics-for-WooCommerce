msgstr[0] "%1$d instelling geïmporteerd. %2$d onbekende sleutel overgeslagen."
msgstr[1] ""
"%1$d instellingen geïmporteerd. %2$d onbekende sleutels overgeslagen."

#: front-end/import-export/brikpanel-import-export.php:387
msgid "Pick a BrikPanel JSON file before clicking Import."
msgstr "Kies een BrikPanel JSON-bestand voordat u op Importeren klikt."

#: front-end/import-export/brikpanel-import-export.php:388
msgid "That file is too large to be a BrikPanel settings export."
msgstr "Dat bestand is te groot om een BrikPanel-instellingenexport te zijn."

#: front-end/import-export/brikpanel-import-export.php:389
