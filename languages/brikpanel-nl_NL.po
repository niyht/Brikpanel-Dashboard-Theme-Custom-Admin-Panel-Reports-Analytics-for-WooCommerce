msgid "Order sync"
msgstr "Bestellingen-synchronisatie"

#: front-end/google-sheets/views/page.php:186
msgid ""
"Push WooCommerce orders to a tab. Each row is one line item — variations get "
"their own row with attribute columns."
msgstr ""
"Push WooCommerce-bestellingen naar een tabblad. Elke rij is één regelitem — "
"variaties krijgen een eigen rij met attribuutkolommen."

#: front-end/google-sheets/views/page.php:190
