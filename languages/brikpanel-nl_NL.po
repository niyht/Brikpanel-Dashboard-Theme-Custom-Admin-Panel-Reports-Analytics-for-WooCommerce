msgstr "%1$s geleden, %2$d rijen"

#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1247
msgid ""
"Enable two-way sync for orders first, then click Save before clicking Pull "
"now."
msgstr ""
"Schakel eerst de tweerichtingssynchronisatie voor bestellingen in, klik op "
"Opslaan en daarna op „Nu ophalen\"."

#. translators: 1: rows checked, 2: changes applied, 3: conflicts
#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1253
#, php-format
msgid ""
"Checked %1$d order rows. Applied %2$d status changes from Sheets, %3$d "
"conflicts skipped."
msgstr ""
"%1$d bestelregels gecontroleerd. %2$d statuswijzigingen uit Sheets "
"toegepast, %3$d conflicten overgeslagen."

#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1262
msgid ""
"Enable two-way sync for products first, then click Save before clicking Pull "
"now."
msgstr ""
"Schakel eerst de tweerichtingssynchronisatie voor producten in, klik op "
"Opslaan en daarna op „Nu ophalen\"."

#. translators: 1: rows checked, 2: changes applied, 3: conflicts
#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1268
#, php-format
msgid ""
"Checked %1$d product rows. Applied %2$d changes from Sheets, %3$d conflicts "
"skipped."
msgstr ""
"%1$d productrijen gecontroleerd. %2$d wijzigingen uit Sheets toegepast, %3$d "
"conflicten overgeslagen."

#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1277
msgid ""
"Enable two-way sync for expenses first, then click Save before clicking Pull "
"now."
msgstr ""
"Zet eerst tweerichtingssynchronisatie voor uitgaven aan en klik op Opslaan "
"voordat u \"Nu ophalen\" gebruikt."

#. translators: 1: rows read, 2: expenses added, 3: expenses updated, 4: rows
#. skipped
#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1283
#, php-format
