msgstr[1] "Bestellingen %1$s samengevoegd. Nieuw besteltotaal: %2$s."

#: front-end/orders/brikpanel-order-merge.php:849
msgid "Duplicate shipping charges were removed; one shipping line was kept."
msgstr "Dubbele verzendkosten zijn verwijderd; één verzendregel is behouden."

