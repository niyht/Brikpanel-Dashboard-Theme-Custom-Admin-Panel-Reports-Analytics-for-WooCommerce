msgstr ""
"Os valores de vendas, pedidos, lucro e clientes usam todo o seu histórico de "
"pedidos do WooCommerce."

#. translators: %s: date BrikPanel was activated.
#: front-end/dashboard/brikpanel-dashboard.php:512
#, php-format
