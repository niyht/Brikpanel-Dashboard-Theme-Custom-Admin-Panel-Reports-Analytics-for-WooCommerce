#: includes/brikpanel-store-summary.php:611
msgid "Source: BrikPanel customer_metrics table (recomputed nightly)."
msgstr ""
"Origem: tabela customer_metrics do BrikPanel (recalculada todas as noites)."

#: includes/brikpanel-store-summary.php:612
msgid "Source: BrikPanel cohort_retention table (recomputed nightly)."
msgstr ""
"Origem: tabela cohort_retention do BrikPanel (recalculada todas as noites)."

#: includes/brikpanel-store-summary.php:613
msgid "Source: WooCommerce Order Attribution (introduced in WC 8.5)."
msgstr "Origem: Atribuição de Pedidos do WooCommerce (introduzida no WC 8.5)."

#: includes/brikpanel-store-summary.php:614
msgid "Source: WooCommerce Subscriptions plugin."
msgstr "Origem: plugin WooCommerce Subscriptions."

#: includes/brikpanel-store-summary.php:615
msgid ""
"Source: order shipping addresses (HPOS wc_order_addresses or postmeta on "
