#. Plugin Name of the plugin
#: brikpanel.php
msgid "BrikPanel: WooCommerce Admin Dashboard Theme"
msgstr "BrikPanel: WooCommerce Yönetici Paneli Teması"

#. Description of the plugin
#: brikpanel.php
msgid "Beautiful and modern Shopify-style WooCommerce admin panel & dashboard, fully free, forever."
msgstr "Güzel ve modern Shopify tarzı WooCommerce yönetim paneli ve kontrol paneli, tamamen ücretsiz, sonsuza kadar."

#. Author of the plugin
#: brikpanel.php
msgid "Brksoft"
msgstr "Brksoft"

#. Author URI of the plugin
#: brikpanel.php
msgid "https://brksoft.com/"
msgstr "https://brksoft.com/"

#: back-end/live/brikpanel-live.php:578
msgid "Home page"
msgstr "Ana sayfa"

#: brikpanel.php:87
msgid "BrikPanel could not load all of its files."
msgstr "BrikPanel dosyalarının tamamını yükleyemedi."

#: brikpanel.php:89
msgid "Some plugin files are missing, most likely from an interrupted update or a security scan. BrikPanel is running in a limited mode. Please reinstall the plugin (deactivate, delete, then install the latest version again) to restore full functionality. Your settings and data are kept."
msgstr "Bazı eklenti dosyaları eksik, büyük olasılıkla yarım kalmış bir güncelleme veya bir güvenlik taraması nedeniyle. BrikPanel sınırlı bir modda çalışıyor. Tüm işlevleri geri getirmek için eklentiyi yeniden kurun (devre dışı bırakın, silin, sonra en son sürümü tekrar kurun). Ayarlarınız ve verileriniz korunur."

#: brikpanel.php:468
msgid "WooCommerce is not active on this site, so BrikPanel features are disabled here. Activate WooCommerce to enable BrikPanel."
msgstr "WooCommerce bu sitede etkin değil, bu nedenle BrikPanel özellikleri burada devre dışı. BrikPanel'i etkinleştirmek için WooCommerce'i aktif edin."

#. translators: %d: number of hidden third-party admin notices
#: brikpanel.php:1175
#, php-format
msgid "%d hidden notice"
msgid_plural "%d hidden notices"
msgstr[0] "%d gizli bildirim"
msgstr[1] "%d gizli bildirim"

#: brikpanel.php:1178
msgid "Other plugins and themes posted these notices. BrikPanel keeps them hidden, click to show."
msgstr "Bu bildirimleri başka eklentiler ve temalar gönderdi. BrikPanel onları gizli tutar, göstermek için tıklayın."

