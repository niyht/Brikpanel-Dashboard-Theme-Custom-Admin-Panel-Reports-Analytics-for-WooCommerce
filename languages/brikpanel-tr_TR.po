#, php-format
msgid "%d item was added to your cart from a shared link."
msgid_plural "%d items were added to your cart from a shared link."
msgstr[0] "%d ürün paylaşılan bir bağlantıdan sepetinize eklendi."
msgstr[1] "%d ürün paylaşılan bir bağlantıdan sepetinize eklendi."

#: front-end/cart-share/brikpanel-cart-share.php:283
msgid ""
"The shared link could not add any products to your cart. They may be out of "
"stock or no longer available."
msgstr ""
"Paylaşılan bağlantı sepetinize hiçbir ürün ekleyemedi. Ürünler stokta "
"olmayabilir veya artık satışta olmayabilir."

