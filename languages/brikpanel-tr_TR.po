msgstr[1] "%1$d ayar içe aktarıldı. %2$d bilinmeyen anahtar atlandı."

#: front-end/import-export/brikpanel-import-export.php:429
msgid "Pick a BrikPanel JSON file before clicking Import."
msgstr "İçe aktar'a tıklamadan önce bir BrikPanel JSON dosyası seçin."

#: front-end/import-export/brikpanel-import-export.php:430
msgid "That file is too large to be a BrikPanel settings export."
msgstr "Bu dosya bir BrikPanel ayarları dışa aktarımı için çok büyük."

#: front-end/import-export/brikpanel-import-export.php:431
msgid "Could not read the uploaded file. Please try again."
msgstr "Yüklenen dosya okunamadı. Lütfen tekrar deneyin."

#: front-end/import-export/brikpanel-import-export.php:432
msgid "That file is not a valid BrikPanel settings export."
msgstr "Bu dosya geçerli bir BrikPanel ayarları dışa aktarımı değil."

#: front-end/import-export/brikpanel-import-export.php:433
msgid "The uploaded file did not contain any BrikPanel settings."
msgstr "Yüklenen dosya herhangi bir BrikPanel ayarı içermiyor."

#: front-end/import-export/brikpanel-import-export.php:446
msgid "Export settings"
msgstr "Ayarları dışa aktar"

#. translators: %d: number of options included
#: front-end/import-export/brikpanel-import-export.php:451
#, php-format
msgid ""
"Download every BrikPanel option as a single JSON file. Includes %d "
"configuration keys: toggles, layout, accent color, sidebar order, dashboard "
"order, notification preferences."
msgstr ""
"Her BrikPanel seçeneğini tek bir JSON dosyası olarak indirin. %d "
"yapılandırma anahtarı içerir: geçişler, düzen, vurgu rengi, kenar çubuk "
"sırası, kontrol paneli sırası, bildirim tercihleri."

