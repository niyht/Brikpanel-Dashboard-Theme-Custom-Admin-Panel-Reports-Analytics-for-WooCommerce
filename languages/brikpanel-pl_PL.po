#: front-end/brikcontrol/brikpanel-brikcontrol.php:51
#: front-end/brikcontrol/brikpanel-brikcontrol.php:56
#: front-end/brikcontrol/brikpanel-brikcontrol.php:91
#: front-end/brikcontrol/class-brikpanel-brikcontrol.php:73
#: front-end/brikcontrol/class-brikpanel-brikcontrol.php:87
#: front-end/brikcontrol/class-brikpanel-brikcontrol.php:300
#: front-end/brikcontrol/views/page.php:42
msgid "Store Health"
msgstr "Stan sklepu"

#: front-end/brikcontrol/brikpanel-brikcontrol.php:94
msgid ""
"BrikControl scans your store in the background and flags issues, like "
"products missing images, from the topbar shield, a dashboard banner, and its "
"own Store Health page. Turn it off to hide all of that and stop the "
"scheduled scans. Your latest results stay saved, so turning it back on "
"restores them."
msgstr ""
"BrikControl skanuje Twój sklep w tle i sygnalizuje problemy, takie jak "
"produkty bez obrazów, z poziomu tarczy w górnym pasku, banera na pulpicie "
"oraz własnej strony Kondycja sklepu. Wyłącz tę funkcję, aby ukryć to "
"wszystko i zatrzymać zaplanowane skany. Twoje ostatnie wyniki pozostaną "
"zapisane, więc ponowne włączenie je przywróci."

#: front-end/brikcontrol/brikpanel-brikcontrol.php:97
msgid "Enable Store Health (BrikControl)"
msgstr "Włącz Kondycję sklepu (BrikControl)"

#: front-end/brikcontrol/brikpanel-brikcontrol.php:100
msgid ""
"When on, the Store Health page, topbar shield, dashboard banner and daily "
"background scans are active. When off, the entire module is dormant: no menu "
"item, no topbar icon, no banner, and no scheduled scans."
msgstr ""
"Gdy włączone, strona Kondycja sklepu, tarcza w górnym pasku, baner na "
"pulpicie oraz codzienne skany w tle są aktywne. Gdy wyłączone, cały moduł "
"jest uśpiony: brak pozycji menu, brak ikony w górnym pasku, brak banera i "
"brak zaplanowanych skanów."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:57
msgid "Product Image Health"
msgstr "Stan obrazów produktów"

#. translators: 1: scanned products, 2: total products
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:156
#, php-format
msgid "Scanning… %1$s / %2$s products"
msgstr "Skanowanie… %1$s / %2$s produktów"

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:569
msgid "No product images found yet."
msgstr "Nie znaleziono jeszcze obrazów produktów."

#. translators: 1: oversize percent, 2: oversize count, 3: total attachments, 4: modern format percent
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:573
#, php-format
msgid "%1$s%% oversized (%2$s of %3$s) · %4$s%% modern format"
msgstr "%1$s%% za dużych (%2$s z %3$s) · %4$s%% w nowoczesnym formacie"

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:598
msgid "Add product images to start the health check."
msgstr "Dodaj obrazy produktów, aby rozpocząć kontrolę stanu."

#. translators: 1: oversized count, 2: modern format percent, 3: missing files
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:601
#, php-format
msgid ""
"%1$s product images are larger than 1 MB. Modern formats (WebP / AVIF) cover "
"%2$s%% of your library. Missing files: %3$s."
msgstr ""
"%1$s obrazów produktów ma rozmiar większy niż 1 MB. Nowoczesne formaty "
"(WebP / AVIF) obejmują %2$s%% Twojej biblioteki. Brakujące pliki: %3$s."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:657
msgid "No products yet — nothing to check."
msgstr "Brak produktów — nie ma czego sprawdzać."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:658
msgid "Add at least one published product to enable image health checks."
msgstr ""
"Dodaj co najmniej jeden opublikowany produkt, aby włączyć kontrole stanu "
"obrazów."

#. translators: %s: plugin name
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:707
#, php-format
msgid "Install %s to compress images and convert to WebP/AVIF automatically."
msgstr ""
"Zainstaluj %s, aby automatycznie kompresować obrazy i konwertować je do WebP/"
"AVIF."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:714
msgid "Install plugin"
msgstr "Zainstaluj wtyczkę"

#. translators: 1: count, 2: percent
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:724
#, php-format
msgid ""
"%1$s product images (%2$s%%) are larger than 1 MB. These slow down your "
"product pages and hurt SEO. Compress them to under 200 KB where possible."
msgstr ""
"%1$s obrazów produktów (%2$s%%) ma rozmiar większy niż 1 MB. Spowalniają one "
"strony produktów i szkodzą SEO. Skompresuj je do mniej niż 200 KB tam, gdzie "
"to możliwe."

#. translators: %s: modern format percent
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:736
#, php-format
msgid ""
"Only %s%% of your product images use WebP / AVIF. Modern formats are 30–50%% "
"smaller than JPEG/PNG with no visible quality loss."
msgstr ""
"Tylko %s%% obrazów produktów używa WebP / AVIF. Nowoczesne formaty są o 30–"
"50%% mniejsze niż JPEG/PNG bez widocznej utraty jakości."

#. translators: %s: missing file count
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:747
#, php-format
msgid ""
"%s product images point to files that no longer exist on disk. Re-upload "
"them or detach the missing media references."
msgstr ""
"%s obrazów produktów wskazuje na pliki, które już nie istnieją na dysku. "
"Prześlij je ponownie lub odłącz brakujące odwołania do mediów."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:756
msgid ""
"Your product images are well-optimised. Keep an eye on this metric as you "
"upload new products."
msgstr ""
"Twoje obrazy produktów są dobrze zoptymalizowane. Obserwuj ten wskaźnik "
"podczas dodawania nowych produktów."

