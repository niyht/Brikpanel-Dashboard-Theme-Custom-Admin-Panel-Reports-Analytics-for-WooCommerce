msgid_plural "Merged in orders %1$s. New order total: %2$s."
msgstr[0] "Scalono zamówienie %1$s. Nowa suma zamówienia: %2$s."
msgstr[1] "Scalono zamówienia %1$s. Nowa suma zamówienia: %2$s."
msgstr[2] "Scalono zamówienia %1$s. Nowa suma zamówienia: %2$s."

#: front-end/orders/brikpanel-order-merge.php:849
