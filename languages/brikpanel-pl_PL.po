msgid "The connection could not be started."
msgstr "Nie udało się rozpocząć połączenia."

#. translators: %s: host name of the BrikPanel connection service, for example brksoft.com.
#: includes/class-brikpanel-proxy-errors.php:212
#, php-format
msgid "The reply from %s was refused because the clock on your server seems to be wrong."
msgstr "Odpowiedź z %s została odrzucona, ponieważ zegar Twojego serwera wydaje się nieprawidłowy."

