msgid "Share cart"
msgstr "Udostępnij koszyk"

#: front-end/cart-share/brikpanel-cart-share.php:559
msgid "Share this cart"
msgstr "Udostępnij ten koszyk"

#: front-end/cart-share/brikpanel-cart-share.php:560
msgid "Anyone who opens this link gets these items in their cart."
msgstr "Każdy, kto otworzy ten link, otrzyma te produkty w swoim koszyku."

