#. Plugin Name of the plugin
#: brikpanel.php
msgid "BrikPanel: WooCommerce Admin Dashboard Theme"
msgstr "BrikPanel: motyw panelu administracyjnego WooCommerce"

#. Description of the plugin
#: brikpanel.php
msgid "Beautiful and modern Shopify-style WooCommerce admin panel & dashboard, fully free, forever."
msgstr "Piękny i nowoczesny panel administracyjny oraz pulpit WooCommerce w stylu Shopify, w pełni darmowy na zawsze."

#. Author of the plugin
#: brikpanel.php
msgid "Brksoft"
msgstr "Brksoft"

#. Author URI of the plugin
#: brikpanel.php
msgid "https://brksoft.com/"
msgstr "https://brksoft.com/"

#: back-end/live/brikpanel-live.php:578
msgid "Home page"
msgstr "Strona główna"

#: brikpanel.php:87
msgid "BrikPanel could not load all of its files."
msgstr "BrikPanel nie mógł wczytać wszystkich swoich plików."

#: brikpanel.php:89
msgid "Some plugin files are missing, most likely from an interrupted update or a security scan. BrikPanel is running in a limited mode. Please reinstall the plugin (deactivate, delete, then install the latest version again) to restore full functionality. Your settings and data are kept."
msgstr "Brakuje niektórych plików wtyczki, najprawdopodobniej z powodu przerwanej aktualizacji lub skanowania bezpieczeństwa. BrikPanel działa w trybie ograniczonym. Zainstaluj wtyczkę ponownie (wyłącz, usuń, a następnie zainstaluj najnowszą wersję), aby przywrócić pełną funkcjonalność. Twoje ustawienia i dane zostają zachowane."

#: brikpanel.php:468
msgid "WooCommerce is not active on this site, so BrikPanel features are disabled here. Activate WooCommerce to enable BrikPanel."
msgstr "WooCommerce nie jest aktywne na tej witrynie, więc funkcje BrikPanel są tutaj wyłączone. Aktywuj WooCommerce, aby włączyć BrikPanel."

#. translators: %d: number of hidden third-party admin notices
#: brikpanel.php:1175
#, php-format
msgid "%d hidden notice"
msgid_plural "%d hidden notices"
msgstr[0] "%d ukryte powiadomienie"
msgstr[1] "%d ukryte powiadomienia"
msgstr[2] "%d ukrytych powiadomień"

#: brikpanel.php:1178
msgid "Other plugins and themes posted these notices. BrikPanel keeps them hidden, click to show."
msgstr "Te powiadomienia pochodzą z innych wtyczek i motywów. BrikPanel je ukrywa, kliknij, aby wyświetlić."

