#: front-end/orders/brikpanel-order-merge.php:1475
#, php-format
msgid "Merged in: %s"
msgstr "Scalone: %s"

#: front-end/orders/brikpanel-order-merge.php:1486
msgid ""
"A merge into this order did not finish. Check its items and the orders you "
"were merging before trying again."
msgstr ""
"Scalanie do tego zamówienia nie zostało dokończone. Sprawdź jego pozycje i "
"zamówienia, które scalałeś, zanim spróbujesz ponownie."

