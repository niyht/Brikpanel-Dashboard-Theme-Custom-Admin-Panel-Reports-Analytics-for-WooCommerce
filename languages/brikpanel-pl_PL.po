#: includes/brikpanel-brikmentor-promo.php:1860
msgid "Reminders on a proven schedule, a coupon only if needed."
msgstr ""
"Przypomnienia według sprawdzonego harmonogramu, kupon tylko w razie potrzeby."

#: includes/brikpanel-brikmentor-promo.php:1864
msgid "Winback"
msgstr "Odzyskiwanie klientów"

#: includes/brikpanel-brikmentor-promo.php:1865
msgid "Brings back customers who stopped ordering."
msgstr "Przywraca klientów, którzy przestali zamawiać."

#: includes/brikpanel-brikmentor-promo.php:1869
msgid "Post-purchase"
msgstr "Po zakupie"

#: includes/brikpanel-brikmentor-promo.php:1870
msgid "What other customers bought alongside, a few days after each order."
msgstr ""
"Co inni klienci kupili razem z tym produktem, kilka dni po każdym zamówieniu."

#: includes/brikpanel-brikmentor-promo.php:1874
msgid "Back in stock"
