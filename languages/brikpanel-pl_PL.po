msgstr "Ponowna próba…"

#. translators: %s: plugin name, BrikPanel.
#: includes/class-brikpanel-proxy-errors.php:321
#, php-format
msgid "Your server stopped the request before %s could finish. Please try again."
msgstr "Twój serwer przerwał żądanie, zanim %s zdążył je dokończyć. Spróbuj ponownie."

#: includes/class-brikpanel-proxy-errors.php:322
msgid "Your server stopped the request before the connection could start."
msgstr "Twój serwer przerwał żądanie, zanim połączenie mogło się rozpocząć."

#: includes/class-brikpanel-proxy-errors.php:344
msgid "Connection cancelled: the permission request was declined on the platform’s consent screen. Nothing was saved. Click Connect to try again."
msgstr "Połączenie anulowane: prośba o uprawnienia została odrzucona na ekranie zgody platformy. Nic nie zostało zapisane. Kliknij Połącz, aby spróbować ponownie."

#: includes/class-brikpanel-proxy-errors.php:347
msgid "The platform needs you to complete the consent screen. Click Connect to try again."
msgstr "Platforma wymaga ukończenia ekranu zgody. Kliknij Połącz, aby spróbować ponownie."

#: includes/class-brikpanel-proxy-errors.php:351
msgid "Google is temporarily unavailable. Please try connecting again in a few minutes."
msgstr "Google jest chwilowo niedostępny. Spróbuj połączyć się ponownie za kilka minut."

#: includes/class-brikpanel-proxy-errors.php:352
msgid "The advertising platform is temporarily unavailable. Please try connecting again in a few minutes."
msgstr "Platforma reklamowa jest chwilowo niedostępna. Spróbuj połączyć się ponownie za kilka minut."

#: includes/class-brikpanel-proxy-errors.php:355
msgid "The connection did not complete. Nothing was saved. Please try again."
msgstr "Połączenie nie zostało ukończone. Nic nie zostało zapisane. Spróbuj ponownie."

#. translators: %s = raw error code reported by the advertising platform.
