msgstr[0] "Zsynchronizowano %d klienta."
msgstr[1] "Zsynchronizowano %d klientów."
msgstr[2] "Zsynchronizowano %d klientów."

#. translators: %d: expense rows written to the sheet
#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1264
#, php-format
