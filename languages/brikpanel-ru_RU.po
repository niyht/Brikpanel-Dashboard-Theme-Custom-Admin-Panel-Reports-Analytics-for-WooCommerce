msgstr "Отправляйте заказы WooCommerce во вкладку. Каждая строка это одна позиция заказа; вариации получают свою строку со столбцами атрибутов."

#: front-end/google-sheets/views/page.php:212
msgid "Enable order sync"
msgstr "Включить синхронизацию заказов"

#: front-end/google-sheets/views/page.php:220 front-end/google-sheets/views/page.php:386 front-end/google-sheets/views/page.php:555 front-end/google-sheets/views/page.php:604
