#: includes/brikpanel-store-summary.php:2615
#, php-format
msgid ""
"%s further expense line is not listed. It is included in every total above."
msgid_plural ""
"%s further expense lines are not listed. They are included in every total "
"above."
msgstr[0] "Ещё %s статья расходов не показана. Она учтена во всех итогах выше."
msgstr[1] "Ещё %s статьи расходов не показаны. Они учтены во всех итогах выше."
msgstr[2] "Ещё %s статей расходов не показано. Они учтены во всех итогах выше."

#: includes/brikpanel-store-summary.php:2644
msgid "Percentage-Based Costs (card commission etc.)"
msgstr "Процентные затраты (комиссия за карты и т. п.)"

#: includes/brikpanel-store-summary.php:2645
msgid ""
"These carry no date of their own: the rate applies to every period, and the "
"amount is that rate applied to the period's revenue."
msgstr ""
"У них нет собственной даты: ставка действует для каждого периода, а сумма "
"равна этой ставке, применённой к выручке периода."

#: includes/brikpanel-store-summary.php:2646
msgid "Rate"
msgstr "Ставка"

#: includes/brikpanel-store-summary.php:2646
#: includes/brikpanel-store-summary.php:2668
msgid "Amount (last 12 months)"
msgstr "Сумма (последние 12 месяцев)"

#: includes/brikpanel-store-summary.php:2666
msgid "Per-Order Costs (packaging, courier surcharge etc.)"
msgstr "Затраты на заказ (упаковка, доплата курьеру и т. п.)"

#: includes/brikpanel-store-summary.php:2667
msgid ""
"Amount is the unit price multiplied by the number of matching paid orders. "
"Each order is claimed by at most one scoped rule, so these rows cannot be re-"
