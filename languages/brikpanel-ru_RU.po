#: front-end/google-sheets/views/page.php:228
msgid "One row per order (items combined in one cell)"
msgstr "Одна строка на заказ (товары объединены в одной ячейке)"

#: front-end/google-sheets/views/page.php:229
msgid "One row per line item (detailed)"
msgstr "Одна строка на позицию заказа (подробно)"

#: front-end/google-sheets/views/page.php:237
msgid "Changing the layout wipes the target tab and re-exports every order in the new format, so rows from the two layouts are never mixed."
msgstr "Изменение формата очищает целевую вкладку и экспортирует каждый заказ заново в новом формате, поэтому строки двух форматов никогда не смешиваются."

#: front-end/google-sheets/views/page.php:241
msgid "Real-time append on new order"
msgstr "Добавление в реальном времени при новом заказе"

#: front-end/google-sheets/views/page.php:249
msgid "Bulk export schedule"
msgstr "Расписание массового экспорта"

#: front-end/google-sheets/views/page.php:252
msgid "Manual only"
msgstr "Только вручную"

#: front-end/google-sheets/views/page.php:253 front-end/google-sheets/views/page.php:490
msgid "Hourly"
msgstr "Ежечасно"

#: front-end/google-sheets/views/page.php:254
