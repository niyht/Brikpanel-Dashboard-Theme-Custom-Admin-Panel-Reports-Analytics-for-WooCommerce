msgid "Show more columns"
msgstr "Показать больше столбцов"

#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1627
msgid "Custom checkout / order fields"
msgstr "Пользовательские поля оформления / заказа"

#: front-end/google-sheets/class-brikpanel-sheets-settings.php:1642
