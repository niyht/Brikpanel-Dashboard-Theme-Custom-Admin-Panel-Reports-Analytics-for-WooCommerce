msgstr "Сканирование… %1$s / %2$s товаров"

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:569
msgid "No product images found yet."
msgstr "Изображения товаров пока не найдены."

#. translators: 1: oversize percent, 2: oversize count, 3: total attachments, 4: modern format percent
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:573
#, php-format
msgid "%1$s%% oversized (%2$s of %3$s) · %4$s%% modern format"
msgstr "%1$s%% слишком большие (%2$s из %3$s) · %4$s%% современный формат"

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:598
msgid "Add product images to start the health check."
msgstr "Добавьте изображения товаров, чтобы начать проверку состояния."

#. translators: 1: oversized count, 2: modern format percent, 3: missing files
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:601
#, php-format
msgid ""
"%1$s product images are larger than 1 MB. Modern formats (WebP / AVIF) cover "
"%2$s%% of your library. Missing files: %3$s."
msgstr ""
"%1$s изображений товаров больше 1 МБ. Современные форматы (WebP / AVIF) "
"покрывают %2$s%% вашей библиотеки. Отсутствующие файлы: %3$s."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:657
msgid "No products yet — nothing to check."
msgstr "Товаров пока нет, нечего проверять."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:658
msgid "Add at least one published product to enable image health checks."
msgstr ""
"Добавьте хотя бы один опубликованный товар, чтобы включить проверки "
"состояния изображений."

#. translators: %s: plugin name
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:707
#, php-format
