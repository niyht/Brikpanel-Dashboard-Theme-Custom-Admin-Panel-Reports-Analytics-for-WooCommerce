msgstr[2] "Восстановлено %s строк."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-bot-traffic-check.php:240
msgid "Bot traffic"
msgstr "Трафик ботов"

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-bot-traffic-check.php:381
msgid "Bot traffic is cleaned up automatically every night."
msgstr "Трафик ботов автоматически очищается каждую ночь."

