msgid "Security check failed."
msgstr "Проверка безопасности не пройдена."

#: includes/brikpanel-cache-clear.php:348
msgid "Insufficient permissions."
msgstr "Недостаточно прав."

#: includes/brikpanel-cache-clear.php:367
