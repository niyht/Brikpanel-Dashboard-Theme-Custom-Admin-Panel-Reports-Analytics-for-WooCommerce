#: front-end/dashboard/brikpanel-dashboard.php:2094
#: front-end/expenses/brikpanel-expenses.php:1044
#: front-end/expenses/brikpanel-expenses.php:1109
#: front-end/expenses/brikpanel-expenses.php:1303
