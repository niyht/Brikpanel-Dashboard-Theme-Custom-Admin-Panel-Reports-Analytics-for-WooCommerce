msgstr "Прокси BrikPanel вернул непроверяемый ответ и был отклонён."

#: front-end/ad-platforms/class-brikpanel-ads-google-client.php:329
msgid "Request to Google Ads failed after retries."
msgstr "Запрос к Google Ads не выполнен после повторных попыток."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:148
msgctxt "Meta ad account status"
msgid "Disabled"
msgstr "Отключён"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:149
msgctxt "Meta ad account status"
msgid "Unsettled"
msgstr "Не оплачен"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:150
msgctxt "Meta ad account status"
msgid "Pending review"
msgstr "Ожидает проверки"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:151
msgctxt "Meta ad account status"
msgid "Pending closure"
msgstr "Ожидает закрытия"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:152
msgctxt "Meta ad account status"
msgid "In grace period"
msgstr "Льготный период"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:153
msgctxt "Meta ad account status"
msgid "Closed"
msgstr "Закрыт"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:154
msgctxt "Meta ad account status"
msgid "Any active"
msgstr "Любой активный"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:155
msgctxt "Meta ad account status"
msgid "Any closed"
msgstr "Любой закрытый"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:156
msgctxt "Meta ad account status"
msgid "Inactive"
msgstr "Неактивен"

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:288
msgid "Meta Ads connection was revoked for security. Please reconnect."
msgstr "Подключение к Meta Ads отозвано из соображений безопасности. Пожалуйста, подключитесь снова."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:302
msgid "Your Meta authorisation is no longer valid, so the connection was dropped. Click Connect Meta Ads to authorise again. Your imported history is untouched."
msgstr "Ваша авторизация Meta больше недействительна, поэтому подключение было разорвано. Нажмите «Подключить Meta Ads», чтобы авторизоваться заново. Импортированная история не затронута."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:303
msgid "Not connected to Meta Ads."
msgstr "Нет подключения к Meta Ads."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:399
msgid "Request to Meta Ads failed after retries."
msgstr "Запрос к Meta Ads не выполнен после повторных попыток."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:422
msgid "Meta rejected the saved authorisation. Click Re-authorize to reconnect your Meta account."
msgstr "Meta отклонила сохранённую авторизацию. Нажмите «Повторная авторизация», чтобы заново подключить аккаунт Meta."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:426
msgid "Your Meta connection is missing the ads_read permission. Click Re-authorize and make sure you leave the advertising permission enabled on the Meta consent screen."
msgstr "В вашем подключении Meta отсутствует разрешение ads_read. Нажмите «Повторная авторизация» и убедитесь, что разрешение на рекламу остаётся включённым на экране согласия Meta."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:428
msgid "Meta rejected the request for this ad account. Check that the ad account ID is correct and that your Meta user can view it."
msgstr "Meta отклонила запрос для этого рекламного аккаунта. Убедитесь, что идентификатор рекламного аккаунта верен и ваш пользователь Meta имеет к нему доступ."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:433
msgid "Meta is rate-limiting this connection right now. The next scheduled sync will pick up where this one stopped."
msgstr "Meta сейчас ограничивает частоту запросов этого подключения. Следующая запланированная синхронизация продолжит с того места, где остановилась текущая."

#: front-end/ad-platforms/class-brikpanel-ads-meta-client.php:435
msgid "Meta could not find that ad account. Check the ad account ID and try again."
msgstr "Meta не нашла этот рекламный аккаунт. Проверьте идентификатор рекламного аккаунта и повторите попытку."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:101
#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:202
#: front-end/ad-platforms/class-brikpanel-ads-settings.php:340
#: front-end/ad-platforms/class-brikpanel-ads-settings.php:416
#: front-end/ad-platforms/class-brikpanel-ads-settings.php:723
