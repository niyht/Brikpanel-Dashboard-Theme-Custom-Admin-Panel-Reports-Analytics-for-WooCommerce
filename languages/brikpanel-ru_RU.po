msgstr[1] "%d товара добавлено в вашу корзину по общей ссылке."
msgstr[2] "%d товаров добавлено в вашу корзину по общей ссылке."

#: front-end/cart-share/brikpanel-cart-share.php:275
msgid ""
"The shared link could not add any products to your cart. They may be out of "
"stock or no longer available."
msgstr ""
"По этой ссылке не удалось добавить товары в вашу корзину. Возможно, их нет в "
"наличии или они больше не доступны."

