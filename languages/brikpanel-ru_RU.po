msgid_plural "Synced %d customers."
msgstr[0] "Синхронизирован %d клиент."
msgstr[1] "Синхронизировано %d клиента."
msgstr[2] "Синхронизировано %d клиентов."

#. translators: %d: expense rows written to the sheet
