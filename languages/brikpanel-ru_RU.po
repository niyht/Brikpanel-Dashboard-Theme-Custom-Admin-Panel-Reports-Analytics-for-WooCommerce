msgstr "Изображения товаров пока не найдены."

#. translators: 1: oversize percent, 2: oversize count, 3: total attachments, 4: modern format percent
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:573
#, php-format
msgid "%1$s%% oversized (%2$s of %3$s) · %4$s%% modern format"
msgstr "%1$s%% слишком большие (%2$s из %3$s) · %4$s%% современный формат"

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:598
msgid "Add product images to start the health check."
msgstr "Добавьте изображения товаров, чтобы начать проверку состояния."

#. translators: 1: oversized count, 2: modern format percent, 3: missing files
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:601
#, php-format
msgid "%1$s product images are larger than 1 MB. Modern formats (WebP / AVIF) cover %2$s%% of your library. Missing files: %3$s."
msgstr "%1$s изображений товаров больше 1 МБ. Современные форматы (WebP / AVIF) покрывают %2$s%% вашей библиотеки. Отсутствующие файлы: %3$s."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:657
msgid "No products yet — nothing to check."
msgstr "Товаров пока нет, нечего проверять."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:658
msgid "Add at least one published product to enable image health checks."
msgstr "Добавьте хотя бы один опубликованный товар, чтобы включить проверки состояния изображений."

#. translators: %s: plugin name
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:707
#, php-format
msgid "Install %s to compress images and convert to WebP/AVIF automatically."
msgstr "Установите %s, чтобы автоматически сжимать изображения и конвертировать в WebP/AVIF."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:714
msgid "Install plugin"
msgstr "Установить плагин"

#. translators: 1: count, 2: percent
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:724
#, php-format
msgid "%1$s product images (%2$s%%) are larger than 1 MB. These slow down your product pages and hurt SEO. Compress them to under 200 KB where possible."
msgstr "%1$s изображений товаров (%2$s%%) больше 1 МБ. Они замедляют страницы товаров и вредят SEO. Сожмите их до 200 КБ или меньше, где возможно."

#. translators: %s: modern format percent
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:736
#, php-format
msgid "Only %s%% of your product images use WebP / AVIF. Modern formats are 30–50%% smaller than JPEG/PNG with no visible quality loss."
msgstr "Только %s%% ваших изображений товаров используют WebP / AVIF. Современные форматы на 30–50%% меньше JPEG/PNG без видимой потери качества."

#. translators: %s: missing file count
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:747
#, php-format
msgid "%s product images point to files that no longer exist on disk. Re-upload them or detach the missing media references."
msgstr "%s изображений товаров указывают на файлы, которых больше нет на диске. Загрузите их повторно или открепите отсутствующие ссылки на медиафайлы."

#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-image-health-check.php:756
msgid "Your product images are well-optimised. Keep an eye on this metric as you upload new products."
msgstr "Ваши изображения товаров хорошо оптимизированы. Следите за этой метрикой при загрузке новых товаров."

#: front-end/brikcontrol/class-brikpanel-brikcontrol-runner.php:44
