#, php-format
msgid "BrikMentor is live: first month %s"
msgstr "BrikMentor è disponibile: primo mese a %s"

#: includes/brikpanel-early-access.php:760
#: includes/brikpanel-early-access.php:1034
#, php-format
msgid "Try BrikMentor for %s"
msgstr "Prova BrikMentor per %s"

#: includes/brikpanel-early-access.php:768
msgid ""
"The AI assistant and email marketing engine for your store data is out now. "
"Automated cart recovery, win-back and segment campaigns, running inside "
