#. Plugin Name of the plugin
#: brikpanel.php
msgid "BrikPanel: WooCommerce Admin Dashboard Theme"
msgstr "BrikPanel: tema dashboard amministratore WooCommerce"

#. Description of the plugin
#: brikpanel.php
msgid "Beautiful and modern Shopify-style WooCommerce admin panel & dashboard, fully free, forever."
msgstr "Pannello di amministrazione e dashboard WooCommerce moderno in stile Shopify, completamente gratuito, per sempre."

#. Author of the plugin
#: brikpanel.php
msgid "Brksoft"
msgstr "Brksoft"

#. Author URI of the plugin
#: brikpanel.php
msgid "https://brksoft.com/"
msgstr "https://brksoft.com/"

#: back-end/live/brikpanel-live.php:578
msgid "Home page"
msgstr "Pagina iniziale"

#: brikpanel.php:87
msgid "BrikPanel could not load all of its files."
msgstr "BrikPanel non ha potuto caricare tutti i suoi file."

#: brikpanel.php:89
msgid "Some plugin files are missing, most likely from an interrupted update or a security scan. BrikPanel is running in a limited mode. Please reinstall the plugin (deactivate, delete, then install the latest version again) to restore full functionality. Your settings and data are kept."
msgstr "Alcuni file del plugin risultano mancanti, molto probabilmente per un aggiornamento interrotto o una scansione di sicurezza. BrikPanel funziona in modalità limitata. Reinstalla il plugin (disattivalo, eliminalo, poi installa di nuovo l'ultima versione) per ripristinare tutte le funzionalità. Le tue impostazioni e i tuoi dati vengono conservati."

#: brikpanel.php:468
msgid "WooCommerce is not active on this site, so BrikPanel features are disabled here. Activate WooCommerce to enable BrikPanel."
msgstr "WooCommerce non è attivo su questo sito, quindi le funzionalità BrikPanel sono disabilitate. Attiva WooCommerce per abilitare BrikPanel."

#. translators: %d: number of hidden third-party admin notices
#: brikpanel.php:1175
#, php-format
msgid "%d hidden notice"
msgid_plural "%d hidden notices"
msgstr[0] "%d avviso nascosto"
