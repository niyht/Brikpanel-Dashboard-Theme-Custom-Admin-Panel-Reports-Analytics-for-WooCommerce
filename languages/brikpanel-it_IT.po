#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:315
msgid "This connection is not available yet, it is pending platform approval."
msgstr "Questa connessione non è ancora disponibile, è in attesa di approvazione dalla piattaforma."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:250
#: front-end/google-sheets/class-brikpanel-sheets-oauth.php:160
msgid "Disconnected."
msgstr "Disconnesso."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:302
#: front-end/google-sheets/class-brikpanel-sheets-oauth.php:203
msgid "OAuth session expired. Please try connecting again."
msgstr "Sessione OAuth scaduta. Prova a connetterti di nuovo."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:309
msgid "Unknown platform in OAuth state."
msgstr "Piattaforma sconosciuta nello stato OAuth."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:321
#: front-end/google-sheets/class-brikpanel-sheets-oauth.php:211
msgid "OAuth callback was for a different user. Aborted."
msgstr "Il callback OAuth era per un utente diverso. Annullato."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:380
#: front-end/google-sheets/class-brikpanel-sheets-oauth.php:279
msgid "Could not save tokens. Please try again."
msgstr "Impossibile salvare i token. Riprova."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:415
msgid "Google Ads connected."
msgstr "Google Ads connesso."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:416
msgid "Meta Ads connected."
msgstr "Meta Ads connesso."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:483
msgid "Meta connected, but the advertising permission (ads_read) was not granted, so no spend can be imported. Click Re-authorize and leave the advertising permission enabled."
msgstr "Meta è stato connesso, ma l’autorizzazione pubblicitaria (ads_read) non è stata concessa, quindi non è possibile importare la spesa. Fai clic su Ri-autorizza e lascia attiva l’autorizzazione pubblicitaria."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:577
msgid "Google Ads connected, but the Google Ads permission was not granted, so no spend can be imported. Click Connect again and leave the Google Ads permission ticked on Google’s permission screen."
msgstr "Google Ads è connesso, ma l’autorizzazione Google Ads non è stata concessa, quindi non è possibile importare alcuna spesa. Fai di nuovo clic su Connetti e lascia selezionata l’autorizzazione Google Ads nella schermata dei permessi di Google."

