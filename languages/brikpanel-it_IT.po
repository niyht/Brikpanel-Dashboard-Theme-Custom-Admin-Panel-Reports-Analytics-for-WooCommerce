msgid_plural "Your daily figures look real. %s scripted abandoned-cart entries can be cleaned up."
msgstr[0] "Le tue cifre giornaliere sembrano reali. %s voce di carrello abbandonato creata da uno script può essere ripulita."
msgstr[1] "Le tue cifre giornaliere sembrano reali. %s voci di carrelli abbandonati create da uno script possono essere ripulite."

#. translators: %s: number of days examined.
#: front-end/brikcontrol/checks/class-brikpanel-brikcontrol-bot-traffic-check.php:521
#, php-format
msgid "No bot traffic found in the last %s day."
msgid_plural "No bot traffic found in the last %s days."
msgstr[0] "Nessun traffico di bot trovato nell’ultimo %s giorno."
msgstr[1] "Nessun traffico di bot trovato negli ultimi %s giorni."

