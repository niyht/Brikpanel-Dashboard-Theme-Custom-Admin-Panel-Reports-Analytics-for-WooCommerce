#: front-end/orders/brikpanel-orders-compact.php:607
#, php-format
msgid "%s ×"
msgstr "%s ×"

#. translators: %s: payment or shipping method name.
#: front-end/orders/brikpanel-orders-compact.php:626
#, php-format
msgid "via %s"
msgstr "tramite %s"

#: front-end/orders/brikpanel-orders-compact.php:652
msgid "No billing address"
msgstr "Nessun indirizzo di fatturazione"

#. translators: %s: phone number.
#: front-end/orders/brikpanel-orders-compact.php:684
#, php-format
msgid "(Phone: %s)"
msgstr "(Telefono: %s)"

#: front-end/orders/brikpanel-orders-compact.php:690
msgid "No shipping address"
msgstr "Nessun indirizzo di spedizione"

#: front-end/orders/brikpanel-orders-compact.php:692
msgid "No shipping needed"
msgstr "Nessuna spedizione necessaria"

