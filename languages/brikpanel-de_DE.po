msgstr "Shop"

#: front-end/orders/brikpanel-orders.php:1160
msgid "System"
msgstr "System"

#: front-end/orders/brikpanel-orders.php:1223
msgid "Choose…"
msgstr "Auswählen…"

#: front-end/orders/brikpanel-orders.php:1352
msgid "BrikPanel settings sections"
msgstr "BrikPanel-Einstellungsabschnitte"

#: front-end/orders/brikpanel-orders.php:1387
#: front-end/orders/brikpanel-orders.php:1390
msgid "Search settings"
msgstr "Einstellungen durchsuchen"

#: front-end/orders/brikpanel-orders.php:1393
msgid "No settings found."
msgstr "Keine Einstellungen gefunden."

#: front-end/orders/brikpanel-orders.php:2925
msgid "BrikPanel settings saved."
msgstr "BrikPanel-Einstellungen gespeichert."

#: front-end/orders/brikpanel-orders.php:3318
msgid "All shipping methods"
msgstr "Alle Versandmethoden"

