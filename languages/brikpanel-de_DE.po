#. Plugin Name of the plugin
#: brikpanel.php
msgid "BrikPanel: WooCommerce Admin Dashboard Theme"
msgstr "BrikPanel: WooCommerce Admin-Dashboard-Theme"

#. Description of the plugin
#: brikpanel.php
msgid "Beautiful and modern Shopify-style WooCommerce admin panel & dashboard, fully free, forever."
msgstr "Schönes und modernes WooCommerce-Adminpanel und -Dashboard im Shopify-Stil, vollständig kostenlos, für immer."

#. Author of the plugin
#: brikpanel.php
msgid "Brksoft"
msgstr "Brksoft"

#. Author URI of the plugin
#: brikpanel.php
msgid "https://brksoft.com/"
msgstr "https://brksoft.com/"

#: back-end/live/brikpanel-live.php:562
msgid "Home page"
msgstr "Startseite"

#: brikpanel.php:87
msgid "BrikPanel could not load all of its files."
msgstr "BrikPanel konnte nicht alle seine Dateien laden."

#: brikpanel.php:89
msgid "Some plugin files are missing, most likely from an interrupted update or a security scan. BrikPanel is running in a limited mode. Please reinstall the plugin (deactivate, delete, then install the latest version again) to restore full functionality. Your settings and data are kept."
msgstr "Einige Plugin-Dateien fehlen, höchstwahrscheinlich wegen eines abgebrochenen Updates oder eines Sicherheitsscans. BrikPanel läuft in einem eingeschränkten Modus. Bitte installieren Sie das Plugin neu (deaktivieren, löschen, dann die neueste Version wieder installieren), um die volle Funktionalität wiederherzustellen. Ihre Einstellungen und Daten bleiben erhalten."

#: brikpanel.php:257
msgid "WooCommerce is not active on this site, so BrikPanel features are disabled here. Activate WooCommerce to enable BrikPanel."
msgstr "WooCommerce ist auf dieser Seite nicht aktiv, daher sind die BrikPanel-Funktionen hier deaktiviert. Aktivieren Sie WooCommerce, um BrikPanel zu aktivieren."

#. translators: %d: number of hidden third-party admin notices
