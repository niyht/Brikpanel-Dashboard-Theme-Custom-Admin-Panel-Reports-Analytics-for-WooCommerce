#: front-end/order-statuses/brikpanel-status-emails.php:584
#: front-end/orders/brikpanel-order-whatsapp.php:1166
msgid "Customer full name"
msgstr "Vollständiger Name des Kunden"

#: front-end/order-statuses/brikpanel-status-emails.php:585
#: front-end/orders/brikpanel-order-whatsapp.php:1173
msgid "Customer email"
msgstr "E-Mail-Adresse des Kunden"

#: front-end/order-statuses/brikpanel-status-emails.php:586
#: front-end/orders/brikpanel-order-whatsapp.php:1174
msgid "Store name"
msgstr "Name des Shops"

#: front-end/order-statuses/brikpanel-status-emails.php:607
msgid "Status change emails"
msgstr "E-Mails bei Statusänderung"

#: front-end/order-statuses/brikpanel-status-emails.php:608
msgid ""
"Send an email automatically when an order moves into one of your custom "
"statuses. Each email is styled like your other WooCommerce emails and can "
"use placeholders such as {order_number}."
msgstr ""
"Senden Sie automatisch eine E-Mail, wenn eine Bestellung in einen Ihrer "
"benutzerdefinierten Status wechselt. Jede E-Mail ist wie Ihre übrigen "
"WooCommerce-E-Mails gestaltet und kann Platzhalter wie {order_number} "
"verwenden."

#: front-end/order-statuses/brikpanel-status-emails.php:613
msgid "Create a custom status above first, then set up its email here."
msgstr ""
"Erstellen Sie zuerst oben einen benutzerdefinierten Status und richten Sie "
"dann hier dessen E-Mail ein."

#: front-end/order-statuses/brikpanel-status-emails.php:633
#: front-end/order-statuses/brikpanel-status-emails.php:772
#: front-end/orders/brikpanel-order-whatsapp.php:1254
