#, php-format
msgid "%d hidden notice"
msgid_plural "%d hidden notices"
msgstr[0] "%d ausgeblendeter Hinweis"
msgstr[1] "%d ausgeblendete Hinweise"

#: brikpanel.php:887
msgid "Other plugins and themes posted these notices. BrikPanel keeps them hidden, click to show."
msgstr "Andere Plugins und Themes haben diese Hinweise erzeugt. BrikPanel hält sie ausgeblendet, zum Anzeigen klicken."

