msgid "\"%1$s\" moved under \"%2$s\""
msgstr "\"%1$s\" verschoben unter \"%2$s\""

#: front-end/products/brikpanel-product-editor.php:112
msgid "Invalid product."
msgstr "Ungültiges Produkt."

#: front-end/products/brikpanel-product-editor.php:228 front-end/products/brikpanel-product-editor.php:239
msgid "Product Editor"
msgstr "Produkteditor"

#: front-end/products/brikpanel-product-editor.php:382 front-end/products/brikpanel-product-editor.php:4881 front-end/products/brikpanel-product-editor.php:6663 front-end/products/brikpanel-product-editor.php:6726 front-end/products/brikpanel-products-list.php:2158 front-end/products/brikpanel-products-list.php:2641
msgid "Product not found."
msgstr "Produkt nicht gefunden."

#: front-end/products/brikpanel-product-editor.php:406
