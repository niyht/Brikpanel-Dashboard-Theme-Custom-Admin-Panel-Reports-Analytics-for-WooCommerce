#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:281
msgid "Unknown platform in OAuth state."
msgstr "Unbekannte Plattform im OAuth-Status."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:293 front-end/google-sheets/class-brikpanel-sheets-oauth.php:185
