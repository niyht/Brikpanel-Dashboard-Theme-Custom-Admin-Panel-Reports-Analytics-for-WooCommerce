#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:380
#: front-end/google-sheets/class-brikpanel-sheets-oauth.php:279
msgid "Could not save tokens. Please try again."
msgstr "Tokens konnten nicht gespeichert werden. Bitte versuchen Sie es erneut."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:415
msgid "Google Ads connected."
msgstr "Google Ads verbunden."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:416
msgid "Meta Ads connected."
msgstr "Meta Ads verbunden."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:483
msgid "Meta connected, but the advertising permission (ads_read) was not granted, so no spend can be imported. Click Re-authorize and leave the advertising permission enabled."
msgstr "Meta wurde verbunden, aber die Werbeberechtigung (ads_read) wurde nicht erteilt, daher können keine Ausgaben importiert werden. Klicken Sie auf Erneut autorisieren und lassen Sie die Werbeberechtigung aktiviert."

#: front-end/ad-platforms/class-brikpanel-ads-oauth.php:577
msgid "Google Ads connected, but the Google Ads permission was not granted, so no spend can be imported. Click Connect again and leave the Google Ads permission ticked on Google’s permission screen."
msgstr "Google Ads ist verbunden, aber die Google-Ads-Berechtigung wurde nicht erteilt, daher können keine Ausgaben importiert werden. Klicken Sie erneut auf „Verbinden“ und lassen Sie die Google-Ads-Berechtigung auf dem Berechtigungsbildschirm von Google angehakt."

