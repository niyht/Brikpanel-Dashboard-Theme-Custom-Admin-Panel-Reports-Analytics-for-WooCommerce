msgid "Notifications"
msgstr "Benachrichtigungen"

#: front-end/orders/brikpanel-orders.php:1071
msgid "Import / Export"
msgstr "Import / Export"

#: front-end/orders/brikpanel-orders.php:1148
msgid "Interface"
msgstr "Oberfläche"

#: front-end/orders/brikpanel-orders.php:1152
