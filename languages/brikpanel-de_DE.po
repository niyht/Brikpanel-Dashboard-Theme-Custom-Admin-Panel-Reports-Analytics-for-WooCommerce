msgid "No image"
msgstr "Kein Bild"

#: front-end/products/brikpanel-category-enhancements.php:131
msgid "Category not found."
msgstr "Kategorie nicht gefunden."

#: front-end/products/brikpanel-category-enhancements.php:138
