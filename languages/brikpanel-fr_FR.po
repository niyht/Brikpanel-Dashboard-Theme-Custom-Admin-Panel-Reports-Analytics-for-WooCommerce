#. Plugin Name of the plugin
#: brikpanel.php
msgid "BrikPanel: WooCommerce Admin Dashboard Theme"
msgstr "BrikPanel : tableau de bord d'administration WooCommerce"

#. Description of the plugin
#: brikpanel.php
msgid "Beautiful and modern Shopify-style WooCommerce admin panel & dashboard, fully free, forever."
msgstr "Panneau d'administration et tableau de bord WooCommerce modernes et élégants, style Shopify, entièrement gratuits, pour toujours."

#. Author of the plugin
#: brikpanel.php
msgid "Brksoft"
msgstr "Brksoft"

#. Author URI of the plugin
#: brikpanel.php
msgid "https://brksoft.com/"
msgstr "https://brksoft.com/"

#: back-end/live/brikpanel-live.php:578
msgid "Home page"
msgstr "Page d’accueil"

#: brikpanel.php:87
msgid "BrikPanel could not load all of its files."
msgstr "BrikPanel n'a pas pu charger tous ses fichiers."

#: brikpanel.php:89
msgid "Some plugin files are missing, most likely from an interrupted update or a security scan. BrikPanel is running in a limited mode. Please reinstall the plugin (deactivate, delete, then install the latest version again) to restore full functionality. Your settings and data are kept."
msgstr "Certains fichiers du plugin sont absents, très probablement à cause d'une mise à jour interrompue ou d'une analyse de sécurité. BrikPanel fonctionne en mode limité. Veuillez réinstaller le plugin (désactivez-le, supprimez-le, puis installez à nouveau la dernière version) pour rétablir toutes les fonctionnalités. Vos réglages et vos données sont conservés."

#: brikpanel.php:468
msgid "WooCommerce is not active on this site, so BrikPanel features are disabled here. Activate WooCommerce to enable BrikPanel."
msgstr "WooCommerce n'est pas actif sur ce site, les fonctionnalités de BrikPanel sont donc désactivées ici. Activez WooCommerce pour activer BrikPanel."

