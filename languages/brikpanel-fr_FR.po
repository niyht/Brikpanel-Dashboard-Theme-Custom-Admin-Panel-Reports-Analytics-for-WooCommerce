msgstr[1] "Commandes %1$s fusionnées. Nouveau total de la commande : %2$s."

#: front-end/orders/brikpanel-order-merge.php:849
msgid "Duplicate shipping charges were removed; one shipping line was kept."
msgstr ""
"Les frais de livraison en double ont été supprimés ; une ligne d’expédition "
"a été conservée."

